# Copy to .env and adjust. Every value below is the built-in default,
# so an empty .env is a valid configuration for local development.

# --- Locale -------------------------------------------------------------
# IANA time zone. Decides which calendar day is "today" and how instants
# are displayed. Container clocks are UTC, so this matters even in the UK.
TZ=Australia/Brisbane

# DD/MM/YYYY | MM/DD/YYYY | YYYY-MM-DD
DATE_FORMAT=DD/MM/YYYY

# metric | imperial — affects form defaults and shopping-list rendering only.
# Stored ingredient units are never rewritten.
MEASUREMENT_SYSTEM=metric

# monday | sunday
WEEK_STARTS_ON=monday

# --- Access -------------------------------------------------------------
# true  = anyone may sign up
# false = sign-up requires an invite code
# The very first account is always allowed regardless, so a fresh deployment
# can never lock you out.
ALLOW_REGISTRATION=false
INVITE_CODE_TTL_DAYS=3

# --- Public demo (leave both false for a normal household deployment) ---
# DISABLE_SIGNUPS overrides ALLOW_REGISTRATION and invite codes entirely once
# an account exists, so only the account(s) already there can ever sign in.
# The very first account is still allowed regardless, so this can never lock
# out an empty deployment.
DISABLE_SIGNUPS=false
# Blocks both self-service password changes and admin-issued temporary
# passwords, so a visitor can't change shared demo credentials for everyone
# else. A forced change already in progress is still let through.
DISABLE_PASSWORD_CHANGES=false
# Re-runs the sample data set (30 meals, 10 plans, a week's schedule) on
# every container start. Destructive — clears and replaces it each time.
# Never enable this against a real household's data.
SEED_ON_START=false

# --- Storage ------------------------------------------------------------
# In Docker this becomes /data/app.db, mounted as a directory so the
# WAL sidecars (-wal, -shm) live alongside it.
DATABASE_PATH=./data/app.db

# --- Auth (required) -----------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
